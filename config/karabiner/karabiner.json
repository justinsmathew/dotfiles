{
    "global": {
        "check_for_updates_on_startup": false,
        "show_in_menu_bar": false
    },
    "profiles": [
        {
            "complex_modifications": {
                "parameters": {
                    "basic.to_if_alone_timeout_milliseconds": 200,
                    "basic.to_if_held_down_threshold_milliseconds": 200
                },
                "rules": [
                    {
                        "description": "Caps Lock -> Escape (tap) / Left Control (hold)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "key_code": "left_control" }],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Right Command -> Hyper (hold) / Right Command (tap)",
                        "manipulators": [
                            {
                                "from": { "key_code": "right_command" },
                                "to": [
                                    {
                                        "set_variable": {
                                            "name": "hyper",
                                            "value": 1
                                        }
                                    }
                                ],
                                "to_after_key_up": [
                                    {
                                        "set_variable": {
                                            "name": "hyper",
                                            "value": 0
                                        }
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "right_command" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper app launcher (Right Command + key)",
                        "manipulators": [
                            {
                                "conditions": [{ "name": "hyper", "type": "variable_if", "value": 1 }],
                                "description": "Hyper+Return -> WezTerm",
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "shell_command": "open -a 'WezTerm.app'" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "hyper", "type": "variable_if", "value": 1 }],
                                "description": "Hyper+B -> Zen Browser",
                                "from": {
                                    "key_code": "b",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "shell_command": "open -a 'Zen Browser.app'" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "hyper", "type": "variable_if", "value": 1 }],
                                "description": "Hyper+E -> Finder",
                                "from": {
                                    "key_code": "e",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "shell_command": "open -a 'Finder.app'" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "hyper", "type": "variable_if", "value": 1 }],
                                "description": "Hyper+D -> Discord",
                                "from": {
                                    "key_code": "d",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "shell_command": "open -a 'Discord.app'" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "hyper", "type": "variable_if", "value": 1 }],
                                "description": "Hyper+M -> Spotify",
                                "from": {
                                    "key_code": "m",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "shell_command": "open -a 'Spotify.app'" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "hyper", "type": "variable_if", "value": 1 }],
                                "description": "Hyper+O -> Obsidian",
                                "from": {
                                    "key_code": "o",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "shell_command": "open -a 'Obsidian.app'" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "hyper", "type": "variable_if", "value": 1 }],
                                "description": "Hyper+C -> Calculator",
                                "from": {
                                    "key_code": "c",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "shell_command": "open -a 'Calculator.app'" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "hyper", "type": "variable_if", "value": 1 }],
                                "description": "Hyper+I -> Calendar",
                                "from": {
                                    "key_code": "i",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "shell_command": "open -a 'Calendar.app'" }],
                                "type": "basic"
                            },
                            {
                                "conditions": [{ "name": "hyper", "type": "variable_if", "value": 1 }],
                                "description": "Hyper+Comma -> Messages",
                                "from": {
                                    "key_code": "comma",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [{ "shell_command": "open -a 'Messages.app'" }],
                                "type": "basic"
                            }
                        ]
                    }
                ]
            },
            "devices": [
                {
                    "identifiers": {
                        "is_keyboard": true,
                        "product_id": 5462,
                        "vendor_id": 51984
                    },
                    "manipulate_caps_lock_led": false
                },
                {
                    "fn_function_keys": [
                        {
                            "from": { "key_code": "f1" },
                            "to": [{ "consumer_key_code": "display_brightness_decrement" }]
                        },
                        {
                            "from": { "key_code": "f2" },
                            "to": [{ "consumer_key_code": "display_brightness_increment" }]
                        },
                        {
                            "from": { "key_code": "f3" },
                            "to": [{ "apple_vendor_keyboard_key_code": "mission_control" }]
                        },
                        {
                            "from": { "key_code": "f5" },
                            "to": [{ "consumer_key_code": "dictation" }]
                        },
                        {
                            "from": { "key_code": "f7" },
                            "to": [{ "consumer_key_code": "rewind" }]
                        },
                        {
                            "from": { "key_code": "f8" },
                            "to": [{ "consumer_key_code": "play_or_pause" }]
                        },
                        {
                            "from": { "key_code": "f9" },
                            "to": [{ "consumer_key_code": "fast_forward" }]
                        },
                        {
                            "from": { "key_code": "f10" },
                            "to": [{ "consumer_key_code": "mute" }]
                        },
                        {
                            "from": { "key_code": "f11" },
                            "to": [{ "consumer_key_code": "volume_decrement" }]
                        },
                        {
                            "from": { "key_code": "f12" },
                            "to": [{ "consumer_key_code": "volume_increment" }]
                        }
                    ],
                    "identifiers": {
                        "is_keyboard": true,
                        "product_id": 5122,
                        "vendor_id": 12771
                    }
                }
            ],
            "name": "Default Profile",
            "virtual_hid_keyboard": {
                "country_code": 0,
                "keyboard_type_v2": "ansi"
            }
        }
    ]
}
